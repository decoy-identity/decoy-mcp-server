{
  "name": "decoy-mcp-server",
  "version": "1.3.0",
  "mcpName": "me.decoys/decoy",
  "description": "Decoy is where a person keeps what their agents know about them: an end-to-end-encrypted memory shared by every agent they connect. This local MCP bridge lets an agent read it before every task and save to it as it works. It also holds their account logins, email aliases and codes, for tasks that need to sign in. The bridge decrypts on your machine; Decoy's servers store ciphertext.",
  "author": "Decoy (https://decoys.me)",
  "license": "MIT",
  "homepage": "https://decoys.me/documentation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decoy-identity/decoy-mcp-server.git"
  },
  "bugs": {
    "url": "https://decoys.me/support"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "decoy-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "memory",
    "mcp",
    "model-context-protocol",
    "decoy",
    "email",
    "privacy",
    "agent",
    "claude"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.11.1",
    "compromise": "14.17.0",
    "fastembed": "2.1.1",
    "mem0ai": "3.3.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./claude-memory": "./dist/claude-memory.js",
    "./webauthn-bridge": "./dist/webauthn-bridge.js",
    "./package.json": "./package.json"
  }
}
