{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "me.decoys/decoy",
  "title": "Decoy",
  "description": "What your agents should know about you, shared by every agent. End-to-end encrypted.",
  "websiteUrl": "https://decoys.me/documentation",
  "repository": {
    "url": "https://github.com/decoy-identity/decoy-mcp-server",
    "source": "github"
  },
  "version": "1.3.1",
  "icons": [
    {
      "src": "https://www.decoys.me/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "decoy-mcp-server",
      "version": "1.3.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:{PORT}/mcp"
      },
      "environmentVariables": [
        {
          "name": "PORT",
          "description": "Local port the bridge listens on (127.0.0.1 only)",
          "default": "3001",
          "format": "number"
        }
      ]
    }
  ]
}
